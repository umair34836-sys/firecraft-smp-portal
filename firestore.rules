rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: replace this UID with your own Firebase Auth UID.
    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == "PASTE_ADMIN_UID";
    }

    match /usernames/{ignLower} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ignLower == ignLower;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "player";
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /applications/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tickets/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "open";
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Add public announcements/news later if needed.
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
